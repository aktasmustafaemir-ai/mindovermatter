{% if section.settings.newsletter or template.name == 'page' and page.handle == 'contact' %}<section class="newsletter"><h2>{{ 'mom.newsletter_title' | t }}</h2>{% form 'customer', id: 'MomNewsletter' %}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<p role="status">{{ 'mom.newsletter_success' | t }}</p>{% else %}<div class="mom-newsletter-field"><label class="visually-hidden" for="MomEmail">{{ 'mom.email' | t }}</label><input id="MomEmail" name="contact[email]" type="email" autocomplete="email" required placeholder="{{ 'mom.email' | t }}"><button type="submit" aria-label="{{ 'mom.subscribe' | t }}">→</button></div>{{ form.errors | default_errors }}{% endif %}{% endform %}</section>{% endif %}
<footer class="mom-live-footer">
  <div class="mom-footer-columns">
    <div class="mom-footer-brand">
      <a href="{{ routes.root_url }}" aria-label="Mind Over Matter">
        {% if section.settings.footer_logo != blank %}
          {{ section.settings.footer_logo | image_url: width: 600 | image_tag: class: 'mom-footer-logo', loading: 'lazy', widths: '180,260,360,600', sizes: '(min-width: 750px) 260px, 190px', alt: 'Mind Over Matter' }}
        {% else %}
          <img class="mom-footer-logo mom-footer-logo--asset" src="{{ 'mom-mind-over-matter-wordmark-black.png' | asset_url }}" width="360" height="140" loading="lazy" alt="Mind Over Matter">
        {% endif %}
      </a>
      <p>HAREKETE GEÇ.</p>
    </div>
    <div><h2>{{ 'mom.shop' | t }}</h2>{% render 'mom-nav', menu: section.settings.menu %}</div>
    <div><h2>{{ 'mom.customer_care' | t }}</h2><a href="{{ routes.search_url }}">{{ 'mom.search' | t }}</a>{% if section.settings.contact != blank or pages.contact != blank %}<a href="{{ section.settings.contact | default: pages.contact.url }}">{{ 'mom.contact' | t }}</a>{% endif %}{% render 'mom-contact-info' %}</div>
    <div><h2>{{ 'mom.follow_us' | t }}</h2><div class="mom-social-links"><a href="{{ section.settings.instagram | default: 'https://www.instagram.com/mindovermatter.wear/' }}" target="_blank" rel="noopener" aria-label="Instagram — @mindovermatter.wear"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>{% if section.settings.tiktok != blank %}<a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 3v13a4 4 0 1 1-4-4m4-9c0 4 2 6 6 6"/></svg></a>{% endif %}</div></div>
  </div>
  <div class="mom-footer-bottom">
    <small>© {{ 'now' | date: '%Y' }}, Mind Over Matter</small>
    {% if shop.enabled_payment_types.size > 0 %}
      <ul class="mom-payment-list" role="list" aria-label="{{ 'mom.payment_methods' | t }}">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag: class: 'mom-payment-icon' }}</li>{% endfor %}</ul>
    {% endif %}
    <nav aria-label="{{ 'mom.legal' | t }}">
      <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{{ 'mom.returns_policy' | t }}</a>
      <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">{{ 'mom.privacy_policy' | t }}</a>
      <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">{{ 'mom.terms_conditions' | t }}</a>
      <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{{ 'mom.shipping_policy' | t }}</a>
    </nav>
  </div>
</footer>
<button type="button" class="mom-back-top" data-back-top aria-label="{{ 'mom.back_top' | t }}" hidden>⌃</button>
{% schema %}
{
  "name": "MOM • Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menü"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer logosu"
    },
    {
      "type": "url",
      "id": "contact",
      "label": "İletişim sayfası"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok"
    },
    {
      "type": "checkbox",
      "id": "newsletter",
      "label": "Tüm sayfalarda bülten alanı",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "MOM • Footer"
    }
  ]
}
{% endschema %}
