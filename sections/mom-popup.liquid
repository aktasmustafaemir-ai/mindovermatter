{% if section.settings.enabled and section.settings.code != blank %}
  {%- assign mom_discount_code_path = section.settings.code | url_encode -%}
  {%- capture mom_discount_url -%}/discount/{{ mom_discount_code_path }}?redirect={{ routes.all_products_collection_url | url_encode }}{%- endcapture -%}
  <button type="button" class="discount-teaser" data-mom-open="MomOffer" aria-controls="MomOffer" aria-haspopup="dialog" hidden>{% if request.locale.iso_code == 'en' %}{{ section.settings.amount }}% OFF{% else %}%{{ section.settings.amount }} İNDİRİM{% endif %}</button>
  <dialog id="MomOffer" class="discount-popup-layer mom-dialog" data-delay="{{ section.settings.delay | times: 1000 }}" data-code="{{ section.settings.code | escape }}" data-auto-show="{% if request.page_type == 'index' %}true{% else %}false{% endif %}" data-active-step="2" aria-labelledby="discount-title">
    <button type="button" class="discount-popup-backdrop" data-mom-close aria-label="{{ 'actions.close' | t }}"></button>
    <section class="discount-popup">
      <button type="button" class="discount-popup-close" data-mom-close aria-label="{{ 'actions.close' | t }}">×</button>
      <div class="discount-popup-image" aria-hidden="true">
        {% if section.settings.image %}
          {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '400,700,1000', sizes: '40vw', loading: 'lazy', alt: '' }}
        {% else %}
          <img src="{{ 'mom-contact-desktop.jpg' | asset_img_url: '700x' }}" width="700" height="933" loading="lazy" alt="">
        {% endif %}
      </div>
      <div class="discount-popup-copy">
        <img class="discount-popup-logo" src="{{ 'mom-mind-over-matter-wordmark-black.png' | asset_url }}" width="360" height="140" alt="Mind Over Matter" loading="lazy">
        <h2 id="discount-title"><span class="discount-percentage">{% if request.locale.iso_code == 'en' %}{{ section.settings.amount }}%{% else %}%{{ section.settings.amount }}{% endif %}</span><span class="discount-heading">{% if request.locale.iso_code == 'en' %}OFF{% else %}İNDİRİM{% endif %}</span></h2>
        <div data-offer-step="2">
          <p class="discount-lead">{{ 'mom.offer_email' | t }}</p>
          {% form 'customer', id: 'MomOfferForm', class: 'discount-email-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter,discount-popup,drop01">
            <label for="MomOfferEmail">{{ 'mom.email' | t }}</label>
            <input id="MomOfferEmail" name="contact[email]" type="email" autocomplete="email" required>
            <label class="discount-consent" for="MomOfferConsent">
              <input id="MomOfferConsent" name="contact[accepts_marketing]" type="checkbox" value="true" required>
              <span>{{ 'mom.consent' | t }} <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">{{ 'mom.privacy_policy' | t }}</a></span>
            </label>
            <button type="submit">{{ 'mom.claim' | t }}<span aria-hidden="true">↗</span></button>
            {% if form.posted_successfully? %}<span data-offer-success hidden></span>{% endif %}
            {{ form.errors | default_errors }}
          {% endform %}
        </div>
        <div data-offer-step="3" hidden>
          <p class="discount-lead">{{ 'mom.use_code' | t }}</p>
          <button type="button" class="discount-code" data-copy><span>{{ section.settings.code | escape }}</span><small>{{ 'mom.copy_code' | t }}</small></button>
          <a class="discount-shop" href="{{ mom_discount_url | strip }}">{{ 'mom.start_shopping' | t }}</a>
        </div>
        <button type="button" class="discount-decline" data-mom-close>{{ 'mom.decline' | t }}</button>
      </div>
    </section>
  </dialog>
{% endif %}
{% schema %}
{
  "name": "MOM Popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Pop-up etkin",
      "default": true
    },
    {
      "type": "text",
      "id": "code",
      "label": "Shopify indirim kodu",
      "default": "DROP01"
    },
    {
      "type": "paragraph",
      "content": "DROP01 kodunu Shopify Admin > İndirimler alanında %10 olarak oluşturun. Pop-up e-posta kaydından sonra kodu gösterir ve alışveriş bağlantısı kodu otomatik uygular."
    },
    {
      "type": "range",
      "id": "amount",
      "label": "İndirim yüzdesi",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Gecikme (sn)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 20
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Görsel"
    }
  ],
  "presets": [
    {
      "name": "MOM Popup"
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
