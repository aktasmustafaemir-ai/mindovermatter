<section class="editorial">
  {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2200 | image_tag: widths: '750,1100,1500,2200', sizes: '100vw', loading: 'lazy' }}{% else %}<img src="{{ 'mom-live-editorial.jpg' | asset_url }}" width="1600" height="1600" alt="Mind Over Matter koleksiyon görünümü" loading="lazy">{% endif %}
  <div class="editorial-shade"></div><div class="mom-editorial-copy"><h2>{{ section.settings.heading | escape }}</h2><p>{{ 'mom.take_action_caption' | t }}</p></div>
</section>
{% schema %}
{
  "name": "MOM • Koleksiyon görseli",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Görsel"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "HAREKETE GEÇ."
    }
  ],
  "presets": [
    {
      "name": "MOM • Koleksiyon görseli"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
