{%- liquid
  assign detail_product = section.settings.product | default: all_products['black-hoodie']
  assign detail_image = section.settings.image | default: detail_product.images[4] | default: detail_product.featured_image
  assign english = false
  if request.locale.iso_code == 'en'
    assign english = true
  endif
-%}
<section class="mom-craft" aria-labelledby="MomCraftTitle-{{ section.id }}">
  <div class="mom-craft-media">
    {% if detail_image != blank %}
      {{ detail_image | image_url: width: 1400 | image_tag: widths: '400,700,1000,1400', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: detail_product.title }}
    {% else %}
      <img src="{{ 'mom-live-editorial.jpg' | asset_img_url: '1000x' }}" width="1000" height="1000" loading="lazy" alt="Mind Over Matter">
    {% endif %}
  </div>
  <div class="mom-craft-copy">
    <p class="mom-eyebrow">02 / {% if english %}FABRIC & DETAILS{% else %}DOKU & DETAY{% endif %}</p>
    <h2 id="MomCraftTitle-{{ section.id }}">{% if english %}THE DIFFERENCE<br>IS IN THE DETAILS.{% else %}DETAYDA<br>FARK VAR.{% endif %}</h2>
    <p class="mom-section-description">{% if english %}Heavyweight cotton. A relaxed silhouette. Details that make Drop 001 your everyday uniform.{% else %}Tok dokulu pamuk. Rahat bir silüet. Drop 001'i günlük stilinin parçası yapan detaylar.{% endif %}</p>
    <dl class="mom-craft-facts">
      <div><dt>350 GSM</dt><dd>{% if english %}Heavyweight, 100% cotton{% else %}Ağır gramaj, %100 pamuk{% endif %}</dd></div>
      <div><dt>OVERSIZE</dt><dd>{% if english %}A relaxed fit for everyday wear{% else %}Günlük kullanım için rahat kalıp{% endif %}</dd></div>
      <div><dt>{% if english %}EMBROIDERY{% else %}NAKIŞ{% endif %}</dt><dd>{% if english %}Mind Over Matter signature details{% else %}Mind Over Matter imza detayları{% endif %}</dd></div>
    </dl>
    <a class="mom-text-link" href="{{ detail_product.url | default: routes.all_products_collection_url }}">{% if english %}Explore the details{% else %}Detayları incele{% endif %}<span aria-hidden="true">↗</span></a>
  </div>
</section>
{% schema %}
{
  "name": "MOM • Doku ve detay",
  "settings": [
    {"type": "product", "id": "product", "label": "Detayı gösterilen ürün"},
    {"type": "image_picker", "id": "image", "label": "Detay görseli"}
  ],
  "presets": [{"name": "MOM • Doku ve detay"}]
}
{% endschema %}
