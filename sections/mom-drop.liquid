{% assign source = section.settings.collection | default: collections.all %}
<section class="mom-catalog-strip">
  {% if section.settings.show_heading %}
    <div class="section-heading">
      <div>
        <p class="mom-eyebrow">01 / {% if request.locale.iso_code == 'en' %}THE COLLECTION{% else %}KOLEKSİYON{% endif %}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
        <p class="mom-section-description">{% if request.locale.iso_code == 'en' %}{{ section.settings.description_en | escape }}{% else %}{{ section.settings.description | escape }}{% endif %}</p>
      </div>
      <a class="mom-text-link" href="{{ source.url }}">{{ 'mom.view_all' | t }}<span aria-hidden="true">↗</span></a>
    </div>
  {% endif %}
  <div class="mom-live-grid">{% for product in source.products limit: section.settings.limit %}{% render 'mom-card', product: product %}{% else %}<p>{{ 'mom.coming_soon' | t }}</p>{% endfor %}</div>
</section>
{% schema %}
{
  "name": "MOM • Drop",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Koleksiyon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "DROP 001"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Açıklama — Türkçe",
      "default": "İki renk. Rahat kalıplar. Her gün seninle."
    },
    {
      "type": "text",
      "id": "description_en",
      "label": "Açıklama — İngilizce",
      "default": "Two colours. Relaxed fits. Made for your everyday."
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Başlığı göster",
      "default": false
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Ürün sayısı",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "MOM • Drop"
    }
  ]
}
{% endschema %}
