<section class="cart-page" data-cart-page data-section-id="{{ section.id }}"><h1>{{ 'mom.shopping_cart' | t }}</h1>{% if cart.empty? %}<div class="cart-page-empty"><p>{{ 'mom.empty_cart' | t }}</p><a class="solid-link" href="{{ routes.all_products_collection_url }}">{{ 'mom.start_shopping' | t }}</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" data-cart-page-form><div class="cart-table"><div class="cart-labels"><span></span><span></span><span>{{ 'mom.price' | t }}</span><span>{{ 'mom.quantity' | t }}</span><span>{{ 'mom.total' | t }}</span></div>{% for item in cart.items %}<article class="cart-page-line"><a href="{{ item.url }}">{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy' }}</a><div class="cart-page-info"><a href="{{ item.url }}">{{ item.product.title | escape }}</a>{% unless item.product.has_only_default_variant %}{% for option in item.options_with_values %}<p>{{ option.name | escape }}: {{ option.value | escape }}</p>{% endfor %}{% endunless %}{% for property in item.properties %}{% assign first_letter = property.first | slice: 0 %}{% unless property.last == blank or first_letter == '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endunless %}{% endfor %}<a href="{{ item.url_to_remove }}" class="cart-trash">{{ 'mom.remove' | t }}</a></div><div class="cart-page-price">{% render 'mom-money', amount: item.final_price %}</div><div class="cart-qty"><button type="button" data-cart-page-step="-1" aria-label="{{ 'accessibility.decrease_quantity' | t }}">−</button><input type="number" name="updates[]" data-line-key="{{ item.key }}" value="{{ item.quantity }}" min="0" aria-label="{{ 'mom.quantity' | t }} — {{ item.product.title | escape }}"><button type="button" data-cart-page-step="1" aria-label="{{ 'accessibility.increase_quantity' | t }}">+</button></div><strong>{% render 'mom-money', amount: item.final_line_price %}</strong></article>{% endfor %}</div><button name="update" class="solid-link" type="submit">{{ 'mom.update_cart' | t }}</button><div class="mom-cart-page-bottom"><div class="mom-cart-page-note"><label for="MomPageNote">{{ 'mom.order_note' | t }}</label><textarea name="note" id="MomPageNote">{{ cart.note | escape }}</textarea></div><div class="cart-page-summary"><p><span>{{ 'mom.subtotal' | t }}</span><strong>{% render 'mom-money', amount: cart.total_price %}</strong></p><small>{{ 'mom.tax_shipping' | t }}</small><button name="checkout" type="submit">{{ 'mom.checkout' | t }}</button></div></div><p class="mom-cart-page-status" role="status" data-cart-page-status></p></form>{% endif %}</section>
{% schema %}
{
  "name": "MOM Cart-Page",
  "settings": [],
  "presets": [
    {
      "name": "MOM Cart-Page"
    }
  ]
}
{% endschema %}
