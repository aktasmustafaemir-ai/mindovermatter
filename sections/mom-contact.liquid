<section class="contact-hero"><picture>{% if section.settings.mobile_image %}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">{% elsif section.settings.image == blank %}<source media="(max-width:749px)" srcset="{{ 'mom-contact-mobile.jpg' | asset_url }}">{% endif %}{% if section.settings.image %}{{ section.settings.image | image_url: width: 2000 | image_tag: fetchpriority: 'high' }}{% else %}<img src="{{ 'mom-contact-desktop.jpg' | asset_url }}" width="1600" height="1600" alt="Mind Over Matter">{% endif %}</picture><div></div><h1>{{ 'mom.contact_title' | t }}</h1></section><section class="mom-contact-details"><h2>{{ 'mom.contact' | t }}</h2>{% render 'mom-contact-info' %}</section><section class="contact-section">{% form 'contact', id: 'MomContact' %}{% if form.posted_successfully? %}<div class="form-success"><h2>{{ 'mom.thanks' | t }}</h2></div>{% else %}{{ form.errors | default_errors }}<input name="contact[name]" required autocomplete="name" placeholder="{{ 'mom.name' | t }} *" aria-label="{{ 'mom.name' | t }}"><div><input name="contact[email]" type="email" required autocomplete="email" placeholder="{{ 'mom.email' | t }} *" aria-label="{{ 'mom.email' | t }}"><input name="contact[phone]" type="tel" autocomplete="tel" placeholder="{{ 'mom.phone' | t }}" aria-label="{{ 'mom.phone' | t }}"></div><input name="contact[order_number]" placeholder="{{ 'mom.order_number' | t }}" aria-label="{{ 'mom.order_number' | t }}"><textarea name="contact[body]" rows="10" required placeholder="{{ 'mom.message' | t }}" aria-label="{{ 'mom.message' | t }}"></textarea><button type="submit">{{ 'mom.send' | t }}</button>{% endif %}{% endform %}</section>
{% schema %}
{
  "name": "MOM Contact",
  "settings": [{"type":"image_picker","id":"mobile_image","label":"Mobil görsel"},
    {
      "type": "image_picker",
      "id": "image",
      "label": "Kapak görseli"
    }
  ],
  "presets": [
    {
      "name": "MOM Contact"
    }
  ]
}
{% endschema %}
