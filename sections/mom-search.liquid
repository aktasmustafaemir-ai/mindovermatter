<section class="search-page"><h1>{% if search.performed %}{{ 'mom.search_for' | t }} “{{ search.terms | escape }}”{% else %}{{ 'mom.search' | t }}{% endif %}</h1><form class="search-box" action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'mom.search_store' | t }}" aria-label="{{ 'mom.search_store' | t }}" autocomplete="off"><button type="button" data-search-clear aria-label="{{ 'mom.clear' | t }}" {% if search.terms == blank %}hidden{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 6 12 12M6 18 18 6"/></svg></button><button type="submit" aria-label="{{ 'mom.search' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></svg></button></form>
{% if search.performed %}<div class="mom-search-layout"><form class="mom-search-filters" action="{{ routes.search_url }}" method="get"><input type="hidden" name="q" value="{{ search.terms | escape }}"><label for="MomSearchType">{{ 'mom.result_type' | t }}</label><select name="type" id="MomSearchType"><option value="product,article,page">{{ 'mom.all_results' | t }}</option><option value="product" {% if search.types.size == 1 and search.types contains 'product' %}selected{% endif %}>{{ 'mom.products' | t }}</option><option value="page" {% if search.types.size == 1 and search.types contains 'page' %}selected{% endif %}>{{ 'mom.pages' | t }}</option><option value="article" {% if search.types.size == 1 and search.types contains 'article' %}selected{% endif %}>{{ 'mom.articles' | t }}</option></select><label for="MomSearchSort">{{ 'mom.sort_by' | t }}</label><select name="sort_by" id="MomSearchSort">{% assign sort = search.sort_by | default: search.default_sort_by %}{% for option in search.sort_options %}<option value="{{ option.value | escape }}" {% if sort == option.value %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select>{% if search.filters.size > 0 %}<h2>{{ 'mom.filter_by' | t }}</h2>{% endif %}{% for filter in search.filters %}<details {% if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank %}open{% endif %}><summary>{{ filter.label | escape }}</summary><div>{% if filter.type == 'price_range' %}<div class="mom-filter-price"><label>{{ 'mom.min_price' | t }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" step="0.01" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %} placeholder="0"></label><label>{{ 'mom.max_price' | t }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" step="0.01" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %} placeholder="{{ filter.range_max | divided_by: 100.0 }}"></label></div>{% else %}{% for value in filter.values %}<label class="mom-filter-value"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}><span>{{ value.label | escape }} ({{ value.count }})</span></label>{% endfor %}{% endif %}</div></details>{% endfor %}<button type="submit" class="mom-filter-submit">{{ 'mom.apply' | t }}</button><a class="mom-filter-reset" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}">{{ 'mom.clear_filters' | t }}</a></form><div><p class="mom-search-count" role="status">{{ search.results_count }} {{ 'mom.results' | t }}</p>{% paginate search.results by 24 %}<div class="search-results mom-live-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'mom-card', product: item %}{% else %}<a class="mom-page-result" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% endif %}<h3>{{ item.title | escape }}</h3><p>{{ item.content | strip_html | truncatewords: 24 }}</p></a>{% endif %}{% else %}<p class="mom-search-empty">{{ 'mom.no_results' | t }}</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="mom-pagination" aria-label="{{ 'mom.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</div></div>{% endif %}</section>
{% schema %}
{
  "name": "MOM Search",
  "settings": [],
  "presets": [
    {
      "name": "MOM Search"
    }
  ]
}
{% endschema %}
