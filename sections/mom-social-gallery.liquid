<section class="mom-social-gallery">
  <h2>
    <a href="https://www.instagram.com/mindovermatter.wear/" target="_blank" rel="noopener">
      {{ 'mom.on_instagram' | t }}
    </a>
  </h2>
  <div>
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.settings.image %}
          {% assign social_link = block.settings.link | default: 'https://www.instagram.com/mindovermatter.wear/' %}
          <a href="{{ social_link }}" target="_blank" rel="noopener" aria-label="Instagram gönderisini aç" {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,480,640,900', sizes: '(min-width: 750px) 25vw, 50vw' }}
          </a>
        {% endif %}
      {% endfor %}
    {% else %}
      {% assign post_links = 'https://www.instagram.com/mindovermatter.wear/p/DdmCq1Xjep-/|https://www.instagram.com/mindovermatter.wear/p/Ddwm0QuDaYW/|https://www.instagram.com/mindovermatter.wear/p/Dd189SQje9M/|https://www.instagram.com/mindovermatter.wear/p/Dd6z8GOjdid/' | split: '|' %}
      {% for i in (1..4) %}
        {% assign image_file = 'mom-instagram-' | append: i | append: '.jpg' %}
        <a href="{{ post_links[forloop.index0] }}" target="_blank" rel="noopener" aria-label="@mindovermatter.wear gönderisi {{ i }}">
          <img src="{{ image_file | asset_url }}" width="480" height="640" loading="lazy" alt="Mind Over Matter Instagram gönderisi {{ i }}">
        </a>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "MOM • Instagram",
  "settings": [],
  "presets": [
    {
      "name": "MOM • Instagram"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gönderi",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Gönderi görseli"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Instagram gönderi bağlantısı"
        }
      ]
    }
  ]
}
{% endschema %}
