<a class="collection-card mom-live-card{% unless product.available %} is-sold-out{% endunless %}" href="{{ product.url }}">
 <div class="mom-card-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: widths: '300,500,750,1000', sizes: '(min-width:750px) 25vw, 50vw', loading: 'lazy', class: 'primary-image' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'mom-placeholder' }}{% endif %}{% if product.images[1] %}{{ product.images[1] | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'hover-image', alt: '' }}{% endif %}{% if product.metafields.custom.coming_soon.value %}<span class="sold-badge">{{ 'mom.coming_soon' | t }}</span>{% elsif product.available == false %}<span class="sold-badge">{{ 'mom.sold_out' | t }}</span>{% endif %}</div>
 <div class="mom-card-copy"><h3>{{ product.title | escape }}</h3>{% if product.type != blank %}<small>{{ product.type | escape }}</small>{% endif %}<p>{% if product.price_varies %}{{ 'mom.from' | t }} {% endif %}{% render 'mom-money', amount: product.price %}{% if product.compare_at_price > product.price %} <s>{% render 'mom-money', amount: product.compare_at_price %}</s>{% endif %}</p>{% for option in product.options_with_values %}{% assign option_name = option.name | downcase %}{% if option_name == 'color' or option_name == 'colour' or option_name == 'renk' %}{% if option.values.size > 1 %}<span class="mom-card-colors">{{ option.values.size }} {{ 'mom.colors' | t }}</span>{% endif %}{% endif %}{% endfor %}</div></a>
