{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
{%- render 'google-site-verification' -%}
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign mom_brand = 'Mind Over Matter'
  assign seo_title = page_title
  assign seo_description = page_description
  if request.page_type == 'index'
    assign seo_title = settings.mom_home_seo_title | default: 'Mind Over Matter | Oversize Hoodie ve Eşofman'
    assign seo_description = settings.mom_home_seo_description | default: 'Mind Over Matter Drop 01 koleksiyonunu keşfet. 350 GSM pamuklu oversize hoodie ve eşofman altları, işlemeli detaylar ve rahat kalıplar.'
  elsif request.page_type == 'collection' and collection.handle == '001'
    assign seo_title = 'Drop 01 | Mind Over Matter'
  endif
  assign og_title = seo_title | default: mom_brand
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.description | default: mom_brand

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ mom_brand }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image and request.page_type != 'index' -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'index' -%}
  {%- liquid
    if settings.mom_home_social_image != blank
      assign home_social_image = settings.mom_home_social_image | image_url: width: 1200
    elsif page_image
      assign home_social_image = page_image | image_url: width: 1200
    else
      assign home_social_image = 'mom-live-hero.jpg' | asset_url
    endif
    assign image_prefix = home_social_image | slice: 0, 2
    if image_prefix == '//'
      assign home_social_image = home_social_image | prepend: 'https:'
    endif
  -%}
  <meta property="og:image" content="{{ home_social_image | escape }}">
  <meta property="og:image:secure_url" content="{{ home_social_image | escape }}">
  <meta name="twitter:image" content="{{ home_social_image | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ seo_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless seo_title contains mom_brand %} &ndash; {{ mom_brand }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if seo_description %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
