{% doc %}
  Outputs one server-rendered ProductGroup with its variants and offers.
  Reviews are drawn from the same product-scoped blocks shown on the page.
  @param {product} product - The current product.
  @param {object} review_blocks - The product section's blocks.
{% enddoc %}
{%- liquid
  assign product_url = canonical_url | split: '?' | first
  if product_url == blank
    assign product_url = shop.url | append: product.url
  endif
  assign product_schema_id = product_url | append: '#product'
  assign description = product.description | strip_html | strip
  if description == blank
    assign description = page_description | default: product.title | strip_html | strip
  endif
  assign currency = cart.currency.iso_code | default: shop.currency
  assign review_count = 0
  assign review_total = 0
  for block in review_blocks
    if block.type == 'review' and block.settings.product.id == product.id and block.settings.author != blank and block.settings.text != blank
      assign review_count = review_count | plus: 1
      assign review_total = review_total | plus: block.settings.rating
    endif
  endfor
  assign return_shipping_rate = settings.mom_schema_return_shipping_rate | strip | replace: ',', '.'
  assign return_digits = return_shipping_rate | remove: '.'
  assign return_dot_count = return_shipping_rate.size | minus: return_digits.size
  assign return_remainder = return_digits | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
  assign return_rate_number = return_shipping_rate | plus: 0
  assign return_rate_valid = false
  if return_digits != blank and return_remainder == blank and return_dot_count <= 1 and return_rate_number > 0
    assign return_rate_valid = true
  endif
-%}
{%- capture product_schema -%}
{
  "@context": "https://schema.org",
  "@type": "ProductGroup",
  "@id": {{ product_schema_id | json }},
  "name": {{ product.title | json }},
  "description": {{ description | json }},
  "url": {{ product_url | json }},
  "productGroupID": {{ product.id | append: '' | json }},
  "brand": {"@type": "Brand", "name": {{ product.vendor | default: 'Mind Over Matter' | json }}},
  {% if product.type != blank %}"category": {{ product.type | json }},{% endif %}
  {% if product.images.size > 0 %}
    "image": [{% for image in product.images %}{% assign image_url = image | image_url: width: 1920 %}{% assign image_prefix = image_url | slice: 0, 2 %}{% if image_prefix == '//' %}{% assign image_url = image_url | prepend: 'https:' %}{% endif %}{{ image_url | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  {% endif %}
  "variesBy": [
    {%- assign first_dimension = true -%}
    {%- for option in product.options_with_values -%}
      {%- assign option_name = option.name | downcase -%}
      {%- assign dimension = '' -%}
      {%- if option_name == 'beden' or option_name == 'size' -%}
        {%- assign dimension = 'https://schema.org/size' -%}
      {%- elsif option_name == 'renk' or option_name == 'color' or option_name == 'colour' -%}
        {%- assign dimension = 'https://schema.org/color' -%}
      {%- endif -%}
      {%- if dimension != blank -%}
        {%- unless first_dimension -%},{%- endunless -%}{{ dimension | json }}
        {%- assign first_dimension = false -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  {% if review_count > 0 %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ review_total | times: 1.0 | divided_by: review_count | round: 1 | json }},
      "reviewCount": {{ review_count | json }},
      "bestRating": 5,
      "worstRating": 1
    },
    "review": [
      {% assign first_review = true %}
      {% for block in review_blocks %}
        {% if block.type == 'review' and block.settings.product.id == product.id and block.settings.author != blank and block.settings.text != blank %}
          {% unless first_review %},{% endunless %}
          {
            "@type": "Review",
            "author": {"@type": "Person", "name": {{ block.settings.author | json }}},
            "reviewBody": {{ block.settings.text | json }},
            "reviewRating": {"@type": "Rating", "ratingValue": {{ block.settings.rating | json }}, "bestRating": 5, "worstRating": 1}
          }
          {% assign first_review = false %}
        {% endif %}
      {% endfor %}
    ],
  {% endif %}
  "hasVariant": [
    {% for variant in product.variants %}
      {% assign variant_url = product_url | append: '?variant=' | append: variant.id %}
      {% assign variant_image = variant.featured_image | default: product.featured_image %}
      {% if variant_image %}
        {% assign variant_image_url = variant_image | image_url: width: 1920 %}
        {% assign image_prefix = variant_image_url | slice: 0, 2 %}
        {% if image_prefix == '//' %}{% assign variant_image_url = variant_image_url | prepend: 'https:' %}{% endif %}
      {% endif %}
      {
        "@type": "Product",
        "@id": {{ variant_url | append: '#variant' | json }},
        "isVariantOf": {"@id": {{ product_schema_id | json }}},
        "name": {% if product.has_only_default_variant %}{{ product.title | json }}{% else %}{{ product.title | append: ' - ' | append: variant.title | json }}{% endif %},
        "description": {{ description | json }},
        "url": {{ variant_url | json }},
        {% if variant_image %}"image": {{ variant_image_url | json }},{% endif %}
        "brand": {"@type": "Brand", "name": {{ product.vendor | default: 'Mind Over Matter' | json }}},
        {% if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
        {% for option in product.options_with_values %}
          {% assign option_index = forloop.index0 %}
          {% assign option_name = option.name | downcase %}
          {% if option_name == 'beden' or option_name == 'size' %}"size": {{ variant.options[option_index] | json }},{% endif %}
          {% if option_name == 'renk' or option_name == 'color' or option_name == 'colour' %}"color": {{ variant.options[option_index] | json }},{% endif %}
        {% endfor %}
        "offers": {
          "@type": "Offer",
          "@id": {{ variant_url | append: '#offer' | json }},
          "url": {{ variant_url | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ currency | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          {% capture shipping_details %}{% render 'mom-shipping-details', variant: variant, currency: currency %}{% endcapture %}
          {% assign shipping_details = shipping_details | strip %}
          {% if shipping_details != blank %}"shippingDetails": {{ shipping_details }},{% endif %}
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "TR",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": 14,
            "returnMethod": "https://schema.org/ReturnByMail",
            "merchantReturnLink": {{ shop.url | append: '/policies/refund-policy' | json }}
            {% if settings.mom_schema_return_fees == 'free' %},"returnFees": "https://schema.org/FreeReturn"
            {% elsif settings.mom_schema_return_fees == 'customer' and return_rate_valid %},
              "returnFees": "https://schema.org/ReturnShippingFees",
              "returnShippingFeesAmount": {"@type": "MonetaryAmount", "currency": "TRY", "value": {{ return_rate_number | json }}}
            {% endif %}
          }
        }
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
{%- endcapture -%}
{%- capture json_less_than -%}\u003c{%- endcapture -%}
{%- capture json_greater_than -%}\u003e{%- endcapture -%}
{%- capture json_ampersand -%}\u0026{%- endcapture -%}
<script type="application/ld+json" id="MomProductStructuredData">{{ product_schema | replace: '<', json_less_than | replace: '>', json_greater_than | replace: '&', json_ampersand }}</script>
