{% doc %}
  Outputs confirmed Türkiye shipping information as JSON or visible text.
  A paid rate is never inferred. Offers of 3,000 TL or more ship free.
  @param {variant} variant - The offer's variant.
  @param {string} currency - The offer currency.
  @param {string} [mode] - Use 'text' for the visible policy summary.
{% enddoc %}
{%- liquid
  assign rate = settings.mom_schema_shipping_rate | strip | replace: ',', '.'
  assign digits = rate | remove: '.'
  assign dot_count = rate.size | minus: digits.size
  assign remainder = digits | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
  assign rate_valid = false
  if digits != blank and remainder == blank and dot_count <= 1 and currency == 'TRY'
    assign rate_valid = true
  endif
  assign rate_number = rate | plus: 0
  assign rate_cents = rate_number | times: 100
  assign free_offer = false
  if currency == 'TRY' and variant.price >= 300000
    assign free_offer = true
  endif
-%}
{%- if mode == 'text' and currency == 'TRY' -%}
  <p>
    {%- if rate_valid -%}
      {% if request.locale.iso_code == 'en' %}Standard Türkiye shipping below 3,000 TL: {% else %}3.000 TL altındaki siparişlerde Türkiye içi standart kargo: {% endif %}{% render 'mom-money', amount: rate_cents %}.
    {%- else -%}
      {% if request.locale.iso_code == 'en' %}For orders below 3,000 TL, the customer pays shipping. The charge is shown at checkout.{% else %}3.000 TL altındaki siparişlerde kargo ücreti müşteriye aittir. Ücret ödeme adımında gösterilir.{% endif %}
    {%- endif %}
    {% if request.locale.iso_code == 'en' %}Standard shipping is free on orders of 3,000 TL or more.{% else %}3.000 TL ve üzeri siparişlerde standart kargo ücretsizdir.{% endif %}
  </p>
{%- elsif currency == 'TRY' -%}
  {%- if rate_valid or free_offer -%}
    {
      "@type": "OfferShippingDetails",
      "shippingDestination": {"@type": "DefinedRegion", "addressCountry": "TR"},
      "shippingRate": {"@type": "MonetaryAmount", "currency": "TRY", "value": {% if free_offer %}0{% else %}{{ rate_number | json }}{% endif %}},
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {"@type": "QuantitativeValue", "minValue": 0, "maxValue": 2, "unitCode": "DAY"},
        "transitTime": {"@type": "QuantitativeValue", "minValue": 1, "maxValue": 4, "unitCode": "DAY"}
      }
    }
  {%- endif -%}
{%- endif -%}
